{
  "name": "linkedin-profile-scraper-tross",
  "version": "0.1.0",
  "private": true,
  "description": "Drift-aware direct LinkedIn protocol adapter and profile extraction API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "protocol:replay": "tsx tools/replay-fixtures.ts",
    "protocol:sanitize": "tsx tools/sanitize-fixture.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "undici": "^7.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.0"
  }
}
