NODE_ENV=development
PORT=3000
PUBLIC_API_KEY=replace-with-at-least-16-random-characters

# Supply all three values through deployment secrets. Never commit real values.
LINKEDIN_COOKIE=
LINKEDIN_CSRF_TOKEN=
LINKEDIN_USER_AGENT=

UPSTREAM_TIMEOUT_MS=8000
REQUEST_DEADLINE_MS=20000
UPSTREAM_CONCURRENCY=2
SECTION_CACHE_TTL_SECONDS=21600
PUBLIC_RATE_LIMIT_MAX=60
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
